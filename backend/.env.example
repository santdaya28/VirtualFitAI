# VirtualFit AI – Backend Environment Configuration

# Server Settings
PROJECT_NAME="VirtualFit AI Backend"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8081"

# PostgreSQL Database Connection
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/virtualfit_db"

# AI Virtual Try-On Integration Settings
# Options: "mock" (default for local development), "fashn", "replicate"
AI_TRYON_PROVIDER="mock"

# API Keys (leave blank for mock mode)
FASHN_API_KEY=""
REPLICATE_API_TOKEN=""

