# ==============================================================================
# VirtualFit AI — Production Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env in production and replace placeholder values with secure,
# production-grade credentials. Never commit your active .env file to Git!

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: 'production' | 'development' | 'testing'
# In production, interactive API docs (/docs, /redoc) are disabled and strict
# security validation is enforced.
ENVIRONMENT=production

# Network Interface and Listening Port
# Behind an Nginx/Caddy reverse proxy, bind to 127.0.0.1.
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# CRITICAL: Generate a cryptographically secure 256-bit random secret.
# Example command to generate: openssl rand -hex 32
SECRET_KEY=replace_with_a_super_secure_random_64_character_hex_string_in_production

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
DATABASE_URL=postgresql+psycopg://virtualfit_user:strong_production_password@localhost:5432/virtualfit_db

# ------------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of authorized frontend origins.
# Never use wildcard '*' in production!
CORS_ORIGINS=https://virtualfit.ai,https://app.virtualfit.ai

# ------------------------------------------------------------------------------
# 5. VIRTUAL TRY-ON (AI ENGINE) CONFIGURATION
# ------------------------------------------------------------------------------
# Active AI Try-On Provider:
# - 'fashn_manual': Zero-budget human-in-the-loop manual Colab workflow (Recommended for MVP)
# - 'mock': Deterministic local simulation for CI and integration tests
# - 'fashn': Direct local/remote GPU worker running genuine FASHN VTON v1.5 (requires NVIDIA GPU)
TRYON_PROVIDER=fashn_manual

# Maximum concurrent AI inferences permitted across background tasks
# Prevents GPU VRAM and CPU exhaustion under concurrent load.
FASHN_MAX_CONCURRENT_INFERENCES=1

# Local weights directory (Only required if TRYON_PROVIDER=fashn)
# Must contain FASHN VTON v1.5 checkpoints, DWPose, and SegFormer weights.
FASHN_VTON_WEIGHTS_DIR=C:/models/fashn-vton-1.5

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & BRUTE FORCE PROTECTION
# ------------------------------------------------------------------------------
# Toggle in-memory sliding window rate limiter ('true' | 'false')
RATE_LIMIT_ENABLED=true

# Authentication rate limits (per client IP)
RATE_LIMIT_LOGIN_MAX_CALLS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

RATE_LIMIT_REGISTER_MAX_CALLS=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
