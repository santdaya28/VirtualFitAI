# VirtualFit AI – Backend Environment Configuration Template
# Copy this file to backend/.env and customize with your local settings.

# Server Configuration
PROJECT_NAME="VirtualFit AI API"
ENVIRONMENT="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (Comma-separated allowed origins for frontend applications)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL Database Connection
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
# Example: postgresql+psycopg://postgres:your_secure_password@localhost:5432/virtualfit_db
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/virtualfit_db"
